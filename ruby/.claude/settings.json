{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Artifact",
      "Bash",
      "Monitor",
      "Skill",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(bundle install:*)",
      "Bash(git clone:*)",
      "Bash(git push:*)",
      "Bash(sudo:*)"
    ],
    "deny": [
      "Edit(.devcontainer/**/*)",
      "Edit(.git/**/*)"
    ]
  }
}
